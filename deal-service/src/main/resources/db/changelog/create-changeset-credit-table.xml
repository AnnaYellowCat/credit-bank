<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="create_credit_table" author="Anna">
        <createTable tableName="credit">
            <column name="credit_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(11, 2)"/>
            <column name="term" type="INTEGER"/>
            <column name="monthly_payment" type="DECIMAL(11, 2)"/>
            <column name="rate" type="DECIMAL(5, 2)"/>
            <column name="psk" type="DECIMAL(11, 2)"/>
            <column name="payment_schedule" type="JSONB"/>
            <column name="insurance_enabled" type="BOOLEAN"/>
            <column name="salary_client" type="BOOLEAN"/>
            <column name="credit_status" type="VARCHAR(10)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>