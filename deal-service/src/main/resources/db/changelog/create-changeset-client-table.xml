<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="create_client_table" author="Anna">
        <createTable tableName="client">
            <column name="client_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(50)"/>
            <column name="last_name" type="VARCHAR(50)"/>
            <column name="middle_name" type="VARCHAR(50)"/>
            <column name="birth_date" type="DATE"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="gender" type="VARCHAR(10)"/>
            <column name="marital_status" type="VARCHAR(13)"/>
            <column name="dependent_amount" type="INTEGER"/>
            <column name="passport" type="JSONB"/>
            <column name="employment" type="JSONB"/>
            <column name="account_number" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>